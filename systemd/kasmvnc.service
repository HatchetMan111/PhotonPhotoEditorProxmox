# kasmvnc.service — KasmVNC Web-Desktop fuer Photon Studio (LXC).
#
# Platzhalter {{USER}} und {{PORT}} werden von lxc-setup/setup.sh ersetzt.
# Danach: systemctl enable --now kasmvnc  →  http://[LXC-IP]:{{PORT}}
[Unit]
Description=KasmVNC Web Desktop (Photon Studio)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{USER}}
PAMName=login
WorkingDirectory=/home/{{USER}}
Environment=HOME=/home/{{USER}}
# X-Session kommt aus ~/.vnc/xstartup (openbox-session + Photon-Autostart).
# -select-de manual: KEIN interaktiver DE-Dialog (wuerde unter systemd mit
# Exit 2 sterben), xstartup bleibt unangetastet (select-de.sh-Logik).
# -websocketPort: Web-UI-Port (HTTPS, selbstsigniert). KEIN -httpPort -
# das gibt es in KasmVNC nicht ("Unrecognized option", Exit 255)!
# -fg: Vordergrund (ohne daemonisiert der Wrapper, Parent exit 0 ->
# "Deactivated successfully" + Restart-Loop mit verwaistem Xvnc).
ExecStart=/usr/bin/kasmvncserver :1 -fg -interface 0.0.0.0 -websocketPort {{PORT}} -FrameRate 30 -depth 24 -geometry 1920x1080 -select-de manual
ExecStop=/usr/bin/kasmvncserver -kill :1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
